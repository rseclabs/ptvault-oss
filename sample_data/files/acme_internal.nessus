      <ReportItem port="8080" svc_name="http-proxy" protocol="tcp" severity="3" pluginID="73334" pluginName="Jenkins Multiple Vulnerabilities" pluginFamily="CGI abuses">
        <synopsis>The Jenkins server is affected by multiple vulnerabilities.</synopsis>
        <description>The Jenkins instance is anonymously accessible. The build console logs contain references to AWS access keys committed to a build artifact, which an attacker could harvest.</description>
