      <ReportItem port="445" svc_name="cifs" protocol="tcp" severity="4" pluginID="100485" pluginName="MS Netlogon: Elevation of Privilege Vulnerability (Zerologon)" pluginFamily="Windows">
        <synopsis>An elevation of privilege vulnerability exists in the Netlogon protocol.</synopsis>
        <description>An unauthenticated attacker with network access to the DC can establish a vulnerable Netlogon secure channel and impersonate the DC, leading to full domain compromise (CVE-2020-1472).</description>
        <solution>Apply the August 2020 Microsoft security updates and enable enforcement mode (FullSecureChannelProtection=1).</solution>
        <risk_factor>Critical</risk_factor>
        <plugin_output>Nessus was able to perform a partial Zerologon authentication.</plugin_output>
        <cvss_base_score>10.0</cvss_base_score>
        <cvss_vector>AV:N/AC:L/Au:N/C:C/I:C/A:C</cvss_vector>
        <exploit_available>true</exploit_available>
        <cve>CVE-2020-1472</cve>
      </ReportItem>
      <ReportItem port="445" svc_name="cifs" protocol="tcp" severity="2" pluginID="57608" pluginName="SMB Signing not required" pluginFamily="Misc.">
        <synopsis>Signing is not required on the remote SMB server.</synopsis>
        <description>Signing is not required on the remote SMB server. An unauthenticated, remote attacker can exploit this to conduct man-in-the-middle attacks against the SMB server.</description>
        <solution>Enforce message signing in the host's configuration. On Windows, this is found in the policy setting 'Microsoft network server: Digitally sign communications (always)'.</solution>
        <risk_factor>Medium</risk_factor>
        <cvss_base_score>5.0</cvss_base_score>
        <cvss_vector>AV:N/AC:L/Au:N/C:N/I:P/A:N</cvss_vector>
        <exploit_available>false</exploit_available>
      </ReportItem>
    </ReportHost>
