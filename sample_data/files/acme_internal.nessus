      <ReportItem port="443" svc_name="www" protocol="tcp" severity="1" pluginID="104743" pluginName="TLS Version 1.0 Protocol Detection" pluginFamily="Service detection">
        <synopsis>The remote service encrypts traffic using a deprecated protocol.</synopsis>
        <description>The remote service accepts connections encrypted using TLS 1.0. TLS 1.0 has known cryptographic flaws.</description>
        <solution>Enable support for TLS 1.2 and/or 1.3, and disable support for TLS 1.0.</solution>
