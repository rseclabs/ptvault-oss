# PTVault Configuration Example
# Copy this file to .env and customize the values

# Signing secrets. Leave these unset: PTVault generates random values on
# first start and keeps them beside the database (flask_secret.key,
# jwt_secret.key, mode 0600). To set them yourself, use at least 32 random
# bytes; PTVault refuses to start with a placeholder or short value.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=
# JWT_SECRET_KEY=

# Database Path (default: ./data/ptvault.db)
DATABASE_PATH=./data/ptvault.db

# JWT Token Expiry (hours)
JWT_EXPIRY_HOURS=24

# Environment (development, production)
ENVIRONMENT=production

# Local debugging only: exception details and tracebacks in API errors, and
# the Werkzeug debugger (loopback, non-production). Leave unset otherwise.
# PTVAULT_DEBUG=1

# Database Encryption (uses sqlcipher3 from requirements.txt)
# The key is held in memory only: after a restart, unlock the database with
# the database passphrase (the setup password) on the unlock page.
# Salt file location (default: the directory containing DATABASE_PATH)
# PTVAULT_ENCRYPTION_SALT_FILE=./data/encryption.salt
# Encryption is required by default (no start without sqlcipher3); 0 turns it off
# PTVAULT_ENCRYPTION_REQUIRED=1
# Unattended restarts (each weakens the at-rest protection; see docs/admin/database-encryption.md):
# PTVAULT_DB_PASSPHRASE=...
# PTVAULT_STORE_KEY_FILE=1
# PTVAULT_ENCRYPTION_KEY_FILE=./data/encryption.key
