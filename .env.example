# PTVault Configuration Example
# Copy this file to .env and customize the values

# Flask Secret Key (generate a random 64-character hex string)
SECRET_KEY=your_secret_key_here

# Database Path (default: ./data/ptvault.db)
DATABASE_PATH=./data/ptvault.db

# JWT Secret Key (generate a random base64-encoded string)
JWT_SECRET_KEY=your_jwt_secret_key_here

# JWT Token Expiry (hours)
JWT_EXPIRY_HOURS=24

# Environment (development, production)
ENVIRONMENT=production

# Database Encryption (uses sqlcipher3-binary from requirements.txt)
# Custom paths for encryption key and salt files
# (default: the directory containing DATABASE_PATH)
# PTVAULT_ENCRYPTION_KEY_FILE=./data/encryption.key
# PTVAULT_ENCRYPTION_SALT_FILE=./data/encryption.salt
# Set to 'true' to require encryption (app won't start without sqlcipher3)
# PTVAULT_ENCRYPTION_REQUIRED=false
